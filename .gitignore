# Môi trường ảo & Cache
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
.ipynb_checkpoints/

# Dữ liệu gốc & đặc trưng dung lượng lớn (>100MB)
data/raw/*.csv
data/raw/*.zip
data/raw/*.parquet
data/raw/*.xlsx
data/*.csv
dataset/
data/processed/
data/features/
pipelines/*/data/

# Kết quả huấn luyện & dự báo dung lượng lớn
pipelines/lightgbm_tweedie/results/metrics/
pipelines/lightgbm_tweedie/results/models/
pipelines/lightgbm_tweedie/results/test/
pipelines/lightgbm_tweedie/results/validation/
pipelines/benchmarks/results/benchmarks/predictions/**/*.csv
pipelines/benchmarks/results/benchmarks/predictions/*.csv
!pipelines/benchmarks/results/benchmarks/predictions/**/.gitkeep
outputs/predictions/*.csv
outputs/predictions/**/*.csv

# Model đã huấn luyện, file tạm & cấu hình cá nhân
*.joblib
*.pkl
*.log
*.tmp
.env
.env.*
!.env.example
.vscode/
.local_evidence/
