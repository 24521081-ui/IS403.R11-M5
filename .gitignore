# Môi trường ảo & Cache
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
.ipynb_checkpoints/

# Dữ liệu gốc & đặc trưng dung lượng lớn (>100MB)
data/raw/*.csv
data/raw/*.zip
data/raw/*.parquet
data/raw/*.xlsx
data/*.csv
dataset/
data/processed/
data/processed/*
data/features/
data/features/*

# Kết quả huấn luyện & dự báo dung lượng lớn (nhánh main)
results/**
!results/**/.gitkeep
!results/benchmarks/
!results/benchmarks/metrics/
!results/benchmarks/metrics/**
!results/figures/
!results/figures/**
!results/wrmsse_v1/
!results/wrmsse_v1/**

# Kết quả dự báo chi tiết của các mô hình đối chứng (>100MB)
results/benchmarks/predictions/**/*.csv
results/benchmarks/predictions/*.csv
!results/benchmarks/predictions/**/.gitkeep
outputs/predictions/*.csv
outputs/predictions/**/*.csv
!outputs/predictions/.gitkeep
!results/*.csv

# Model đã huấn luyện, file tạm & cấu hình cá nhân
*.joblib
*.pkl
*.log
*.tmp
.env
.env.*
!.env.example
.vscode/
.local_evidence/
